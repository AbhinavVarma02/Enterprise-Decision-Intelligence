{
  "name": "edi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Enterprise Decision Intelligence decision workspace (static, Cloudflare Pages)",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint src e2e --max-warnings 0",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^1.80.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^26.6.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^31.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}

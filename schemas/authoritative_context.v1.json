{
  "$defs": {
    "Constraints": {
      "additionalProperties": false,
      "properties": {
        "resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        },
        "budget": {
          "minimum": 0,
          "title": "Budget",
          "type": "number"
        },
        "min_commitment": {
          "default": 0.0,
          "minimum": 0,
          "title": "Min Commitment",
          "type": "number"
        },
        "extra": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Extra",
          "type": "object"
        }
      },
      "required": [
        "resources",
        "budget"
      ],
      "title": "Constraints",
      "type": "object"
    },
    "FinancialAssumptions": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "default": "USD (assumed)",
          "title": "Currency",
          "type": "string"
        },
        "price": {
          "exclusiveMinimum": 0,
          "title": "Price",
          "type": "number"
        },
        "unit_cost": {
          "exclusiveMinimum": 0,
          "title": "Unit Cost",
          "type": "number"
        },
        "holding": {
          "minimum": 0,
          "title": "Holding",
          "type": "number"
        },
        "disposal": {
          "minimum": 0,
          "title": "Disposal",
          "type": "number"
        },
        "goodwill": {
          "minimum": 0,
          "title": "Goodwill",
          "type": "number"
        },
        "shelf_life_days": {
          "maximum": 60,
          "minimum": 1,
          "title": "Shelf Life Days",
          "type": "integer"
        },
        "terminal_waste_risk": {
          "maximum": 1,
          "minimum": 0,
          "title": "Terminal Waste Risk",
          "type": "number"
        }
      },
      "required": [
        "price",
        "unit_cost",
        "holding",
        "disposal",
        "goodwill",
        "shelf_life_days",
        "terminal_waste_risk"
      ],
      "title": "FinancialAssumptions",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "lead_days": {
          "maximum": 3,
          "minimum": 0,
          "title": "Lead Days",
          "type": "integer"
        },
        "unit_cost": {
          "exclusiveMaximum": 1000000.0,
          "exclusiveMinimum": 0,
          "title": "Unit Cost",
          "type": "number"
        },
        "capacity": {
          "exclusiveMaximum": 1000000000.0,
          "minimum": 0,
          "title": "Capacity",
          "type": "number"
        },
        "min_quantity": {
          "default": 0.0,
          "minimum": 0,
          "title": "Min Quantity",
          "type": "number"
        },
        "eligible": {
          "default": true,
          "title": "Eligible",
          "type": "boolean"
        },
        "available": {
          "default": true,
          "title": "Available",
          "type": "boolean"
        },
        "attributes": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "name",
        "lead_days",
        "unit_cost",
        "capacity"
      ],
      "title": "Resource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the validator trusts: master data of record, governance policy, latest signals.",
  "properties": {
    "constraints": {
      "$ref": "#/$defs/Constraints"
    },
    "financial_assumptions": {
      "$ref": "#/$defs/FinancialAssumptions"
    },
    "approval_threshold": {
      "minimum": 0,
      "title": "Approval Threshold",
      "type": "number"
    },
    "max_share": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Max Share",
      "type": "object"
    },
    "freshness_max_age_hours": {
      "default": 30,
      "exclusiveMinimum": 0,
      "title": "Freshness Max Age Hours",
      "type": "number"
    },
    "signals": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Signals",
      "type": "object"
    },
    "investigation_cost": {
      "default": 0.0,
      "minimum": 0,
      "title": "Investigation Cost",
      "type": "number"
    },
    "review_cost": {
      "default": 0.0,
      "minimum": 0,
      "title": "Review Cost",
      "type": "number"
    }
  },
  "required": [
    "constraints",
    "financial_assumptions",
    "approval_threshold"
  ],
  "title": "AuthoritativeContext",
  "type": "object"
}
